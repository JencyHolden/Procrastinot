{
  "openapi": "3.1.0",
  "info": {
    "title": "Procrastinot API",
    "version": "0.0.2",
    "description": "Comprehensive API for managing focus rooms, study sessions, accountability tasks, and room members."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "url": "http://127.0.0.1:5001/csc-245-project-v2/us-central1/helloWorld",
      "description": "dev"
    }
  ],
  "paths": {
    "/rooms": {
      "get": {
        "summary": "List Rooms",
        "responses": {
          "200": {
            "description": "A list of focus rooms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Room",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Room created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400Error"
          }
        }
      }
    },
