  "components": {
    "schemas": {
      "Room": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mode",
          "inviteCode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "pomodoro",
              "deep"
            ]
          },
          "inviteCode": {
            "type": "string"
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": [
          "name",
          "mode"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "mode": {
            "type": "string",
            "enum": [
              "pomodoro",
              "deep"
            ]
          }
        }
      },
      "JoinRoomRequest": {
        "type": "object",
        "required": [
          "inviteCode"
        ],
        "properties": {
          "inviteCode": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "pomodoro",
              "deep"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "break"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "durationSec": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": [
          "mode",
          "durationSec"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "pomodoro",
              "deep"
            ]
          },
          "durationSec": {
            "type": "integer",
            "minimum": 60
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "title",
          "status",
          "persistAfterSession",
          "retentionSec"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "completed"
            ]
          },
          "progressPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "persistAfterSession": {
            "type": "boolean",
            "default": false
          },
          "retentionSec": {
            "type": "integer",
            "description": "Time in seconds before the task is automatically deleted."
          }
        }
      },
      "CreateTaskRequest": {
        "type": "object",
        "required": [
          "userId",
          "title",
          "persistAfterSession",
          "retentionSec"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "persistAfterSession": {
            "type": "boolean"
          },
          "retentionSec": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "completed"
            ]
          },
          "progressPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "username",
          "displayName"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "SessionUserProgress": {
        "type": "object",
        "required": [
          "user",
          "tasks"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "400Error": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404Error": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}